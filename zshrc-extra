# No need to bind, we can use oh-my-zsh vi-mode plugin.
# bindkey -v 

export PATH=$HOME/apps/bin:$PATH

# Add cmux CLI tools on macOS if installed. Appended (not prepended) because
# the bin folder ships its own `open`, which would shadow /usr/bin/open.
if [[ "$OSTYPE" == darwin* ]] && [ -d "/Applications/cmux.app/Contents/Resources/bin" ]; then
    export PATH="$PATH:/Applications/cmux.app/Contents/Resources/bin"
fi

alias dk=docker
alias kc=kubectl
alias aws-whoami='aws sts get-caller-identity'

if [ -x $(command -v thefuck) ]; then 
    eval $(thefuck --alias)
fi

aws_profile() {
    profile_name=""
    if [[ -n "$AWS_DEFAULT_PROFILE" ]]; then
        profile_name="$AWS_DEFAULT_PROFILE"
    elif [[ -n "$AWS_PROFILE" ]]; then
        profile_name="$AWS_PROFILE"
    fi
    if [[ -n "$profile_name" ]]; then
        echo -n " $profile_name "
    fi
}

NEWLINE=$'\n'
export PROMPT="$PROMPT %{$fg_bold[blue]%}[%D{%Y-%m-%d} %D{%H:%M:%S}] AWS:$(aws_profile)%{$reset_color%}  ${NEWLINE}▶ "
